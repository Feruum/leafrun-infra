# syntax=docker/dockerfile:1.7
FROM golang:1.27.0-bookworm@sha256:ded31c68586d2e49e760acc2e65a884b23d032e9bbbed0ae0c55abd3fcaf4452 AS source
WORKDIR /src
COPY --from=contracts . ./contracts
COPY --from=core . ./core
COPY --from=platform . ./platform
COPY --from=integrations . ./integrations
COPY --from=generation . ./generation
RUN printf 'go 1.27.0\nuse (\n ./generation\n ./contracts\n ./core\n ./platform\n ./integrations\n)\nreplace github.com/leafrun/leafrun-contracts v0.1.0 => ./contracts\nreplace github.com/leafrun/leafrun-document-core v0.1.0 => ./core\nreplace github.com/leafrun/leafrun-platform v0.1.0 => ./platform\nreplace github.com/leafrun/leafrun-integrations v0.1.0 => ./integrations\n' > go.work
WORKDIR /src/generation
FROM source AS service-build
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -buildvcs=false -trimpath -o /out/leafrun-generation ./cmd/leafrun-generation
FROM source AS renderer-build
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -buildvcs=false -trimpath -o /out/leafrun-renderer ./cmd/leafrun-renderer && CGO_ENABLED=0 go build -buildvcs=false -trimpath -o /out/leafrun-supervisor ./cmd/leafrun-supervisor
FROM source AS typst
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 3 https://github.com/typst/typst/releases/download/v0.15.1/typst-x86_64-unknown-linux-musl.tar.xz -o /tmp/typst.tar.xz && echo 'a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c  /tmp/typst.tar.xz' | sha256sum --check && tar -xJf /tmp/typst.tar.xz -C /tmp && install -m 755 /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab AS renderer
COPY --from=renderer-build /out/leafrun-renderer /leafrun-renderer
COPY --from=renderer-build /out/leafrun-supervisor /leafrun-supervisor
COPY --from=typst /usr/local/bin/typst /usr/local/bin/typst
WORKDIR /work
USER 65532:65532
ENTRYPOINT ["/leafrun-supervisor"]
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab AS service
COPY --from=service-build /out/leafrun-generation /leafrun-generation
USER 65532:65532
ENTRYPOINT ["/leafrun-generation"]
