# syntax=docker/dockerfile:1.7
FROM golang:1.27.0-bookworm@sha256:ded31c68586d2e49e760acc2e65a884b23d032e9bbbed0ae0c55abd3fcaf4452 AS build
WORKDIR /src
COPY --from=contracts . ./contracts
COPY --from=platform . ./platform
COPY --from=audit . ./audit
RUN printf 'go 1.27.0\nuse (\n ./audit\n ./contracts\n ./platform\n)\nreplace github.com/leafrun/leafrun-contracts v0.1.0 => ./contracts\nreplace github.com/leafrun/leafrun-platform v0.1.0 => ./platform\n' > go.work
WORKDIR /src/audit
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -buildvcs=false -trimpath -o /out/leafrun-audit ./cmd/leafrun-audit
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/leafrun-audit /leafrun-audit
USER 65532:65532
ENTRYPOINT ["/leafrun-audit"]
